  "scenarios": [
    {
      "id": "basicBooking",
      "name": "End-to-end successful booking",
      "startScreenId": "chooseRoomScreen",
      "steps": [
        "On the booking screen, select 'Garden Room', pick a date, set guests to '5', then tap 'Continue'.",
        "On the contact screen, enter 'Jordan Taylor' and 'jordan@example.com', then tap 'Review booking'.",
        "Confirm all values on the review screen, then tap 'Confirm booking'.",
        "Booking confirmation screen displays all details. Tap 'Start again' to return to the start."
      ],
      "expectedResult": "All entered values are shown accurately in the review and confirmation screens.",
      "requirementIds": []
    },
