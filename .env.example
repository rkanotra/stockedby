# Server-side only — set in Vercel project env vars, never commit real values.
ANTHROPIC_API_KEY=
# Optional: enables app/api/test's on-demand harvest (lib/harvestClients.js)
# for chatgpt/gemini when a category+market has no snapshot newer than 30
# days. Without these, that path is skipped and the engine tab falls back to
# whatever snapshot exists, or "data coming soon" — same as before this
# feature. Same keys scripts/harvest.py reads for the offline batch harvest.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional email delivery for the fix tool. StockedBy runs without a
# database; reports and account data are not persisted.
RESEND_API_KEY=
# "Name <email@yourverifieddomain>" — must be on a domain verified in
# Resend. Falls back to onboarding@resend.dev (Resend's sandbox address,
# which can only send to your OWN Resend account email) if unset.
FROM_EMAIL=
# Where founder notifications go. If unset, they are skipped.
FOUNDER_EMAIL=
# Optional site origin. Defaults to https://stockedby.com.
NEXT_PUBLIC_SITE_URL=

# Separate StockedBy GA4 web-stream ID. Public identifier, not a secret.
# Disable enhanced measurement in GA4: this app sends sanitized page views.
NEXT_PUBLIC_GA_ID=
