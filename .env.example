# Server-side only — set in Vercel project env vars, never commit real values.
ANTHROPIC_API_KEY=
# Optional: enables app/api/test's on-demand harvest (lib/harvestClients.js)
# for chatgpt/gemini when a category+market has no snapshot newer than 30
# days. Without these, that path is skipped and the engine tab falls back to
# whatever snapshot exists, or "data coming soon" — same as before this
# feature. Same keys scripts/harvest.py reads for the offline batch harvest.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Phase 4 — persistence + capture + share (see CLAUDE.md, supabase/migrations/
# 0001_phase4_schema.sql). All optional: absent, every Phase 4 feature
# degrades gracefully to its pre-Phase-4 behavior rather than failing the
# free test — see lib/supabaseClient.js / lib/email.js.
#
# Service-role key (bypasses RLS) — server-only, same rule as every other
# key here. Run supabase/migrations/0001_phase4_schema.sql in the Supabase
# SQL editor before setting these, or every Phase 4 read/write just logs a
# "table not found" error and continues.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Without this, app/api/lead still validates + unlocks the report and still
# saves the lead (if Supabase is configured) — it just skips sending mail.
RESEND_API_KEY=
# "Name <email@yourverifieddomain>" — must be on a domain verified in
# Resend. Falls back to onboarding@resend.dev (Resend's sandbox address,
# which can only send to your OWN Resend account email) if unset.
FROM_EMAIL=
# Where the founder-notification email (new lead + report link) goes. If
# unset, that email is simply skipped — the merchant confirmation still sends.
FOUNDER_EMAIL=
# Optional — base URL used to build the /report/[slug] link in emails
# (lib/site.js). Defaults to https://stockedby.com.
NEXT_PUBLIC_SITE_URL=
